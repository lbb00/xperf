root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonl,md}]
indent_size = 2

[*.{js,mjs,cjs,ts}]
indent_size = 2

[Makefile]
indent_style = tab

[*.zig]
indent_size = 4

[*.{java,kt,kts}]
indent_size = 4

[*.{c,h,cpp,hpp}]
indent_size = 4
